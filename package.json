{
  "name": "@swaggerexpert/arazzo-criterion",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.2.0",
  "description": "Arazzo Criterion Object (simple type) parser, validator and evaluator.",
  "main": "./cjs/index.cjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./es/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "watch": {
    "test": "{src,test}/**/*.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "prepack": "npm run build:types",
    "grammar:compile": "node ./scripts/apg-js.js --lite --in=./src/grammar.bnf --out=./src/grammar.js",
    "build": "npm run grammar:compile && npm run build:es && npm run build:cjs && npm run build:cjs:apg-lite && npm run build:types",
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir es --extensions '.js' --out-file-extension '.mjs'",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir cjs --extensions '.js' --out-file-extension '.cjs'",
    "build:cjs:apg-lite": "cross-env BABEL_ENV=cjs babel node_modules/apg-lite/lib/parser.js --out-file ./cjs/apg-lite.cjs",
    "build:types": "node -e \"require('node:fs').copyFileSync('types/index.d.ts', 'types/index.d.cts')\"",
    "test": "cross-env UPDATE_SNAPSHOT=new mocha",
    "test:watch": "npm-watch test",
    "watch": "npm-watch"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/swaggerexpert/arazzo-criterion.git"
  },
  "keywords": [
    "arazzo",
    "criterion",
    "simple",
    "condition",
    "parser",
    "validator",
    "evaluator"
  ],
  "author": "Vladimír Gorej <vladimir.gorej@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/swaggerexpert/arazzo-criterion/issues"
  },
  "homepage": "https://github.com/swaggerexpert/arazzo-criterion#readme",
  "files": [
    "es/",
    "cjs/",
    "types/",
    "LICENSE",
    "NOTICE",
    "package.json",
    "README.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "@swaggerexpert/arazzo-runtime-expression": "^3.4.0",
    "apg-lite": "^1.0.7"
  },
  "devDependencies": {
    "@babel/cli": "=8.1.0",
    "@babel/core": "=8.1.3",
    "@babel/preset-env": "=8.0.7",
    "@commitlint/cli": "=21.2.4",
    "@commitlint/config-conventional": "=21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "apg-js": "^4.4.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "chai": "=6.3.0",
    "cross-env": "^10.0.0",
    "husky": "=9.1.7",
    "mocha": "=12.0.3",
    "mocha-expect-snapshot": "^8.0.0",
    "npm-watch": "^0.13.0",
    "prettier": "^3.1.1",
    "semantic-release": "^26.0.1"
  },
  "overrides": {
    "jest-snapshot": "^30.4.1",
    "@babel/core": "$@babel/core"
  }
}
